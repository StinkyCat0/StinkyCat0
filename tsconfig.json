{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["es2022", "dom"],
    "types": ["node"]
  },
  "include": ["game/**/*.ts", "worker/**/*.ts", "test/**/*.ts"]
}
